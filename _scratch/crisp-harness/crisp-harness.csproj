<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exercises the shipping transcription code without the app:
         - CrispAsrServerTranscriber against the REAL crispasr.exe in
           %APPDATA%\.WhisperInk\cohere-gguf (CPU only, ports 18997/18998)
         - HttpTranscriber (ElevenLabs request shape, deadlines) against a
           local fake server on 127.0.0.1:18999
         - TranscriptionDeadline, TranscriptCoverage, UnsentTakes as pure code
       and asserts on results and on what reaches the log.
       Run: make-speech.ps1, then `dotnet run`. Passing the argument "fast"
       skips the real crispasr runs and the slower-than-15s server check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\CrispAsrServerTranscriber.cs" />
    <Compile Include="..\..\HttpTranscriber.cs" />
    <Compile Include="..\..\TranscriptionDeadline.cs" />
    <Compile Include="..\..\TranscriptCoverage.cs" />
    <Compile Include="..\..\UnsentTakes.cs" />
    <Compile Include="..\..\AppConfig.cs" />
    <Compile Include="..\..\ITranscriber.cs" />
    <Compile Include="..\..\ModulateTranscriber.cs" />
    <Compile Include="..\..\SmallestTranscriber.cs" />
    <Compile Include="..\..\Reson8Transcriber.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- TranscriptCoverage reads WAVs with NAudio's WaveFileReader. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="speech.wav" CopyToOutputDirectory="PreserveNewest" Condition="Exists('speech.wav')" />
  </ItemGroup>
</Project>

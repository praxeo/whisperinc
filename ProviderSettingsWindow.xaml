<Window x:Class="WhisperInk.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Provider Settings"
        Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Dark ComboBox: the stock WPF template ignores Background and renders
             our light #CCC text on near-white system chrome ("gray on white").
             This template keeps both the closed box and the drop-down list dark
             so the active-provider name and every option stay readable. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#CCC"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,0,22,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="#2D2D2D" BorderBrush="#555" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Provider selector — the provider visible here becomes the
             active provider when Save is pressed. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel>
                <Label DockPanel.Dock="Left" Content="Active provider:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <Button x:Name="BtnDelete" DockPanel.Dock="Right" Content="✕ Delete" Click="BtnDelete_Click"
                        Background="#4A2020" Margin="4,0,0,0"/>
                <Button x:Name="BtnAdd" DockPanel.Dock="Right" Content="+ Add" Click="BtnAdd_Click"/>
                <ComboBox x:Name="CmbProviders" DisplayMemberPath="Name"
                          Background="#2D2D2D" Foreground="#CCC" FontSize="12"
                          SelectionChanged="CmbProviders_SelectionChanged"
                          ToolTip="The provider shown here is the one that will be used for the next dictation after you click Save."/>
            </DockPanel>
            <TextBlock x:Name="ActiveProviderHint"
                       Foreground="#888" FontSize="10" Margin="0,2,0,0"
                       Text="Saving the dialog applies this provider immediately — no restart needed."/>
        </StackPanel>

        <!-- Provider fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel" Margin="0,0,0,10">
                <DockPanel Margin="0,0,0,4">
                    <Label DockPanel.Dock="Left" Content="Display Name"/>
                    <TextBlock x:Name="TxtTranscriberKind" DockPanel.Dock="Right"
                               Foreground="#888" FontSize="10" VerticalAlignment="Center"
                               ToolTip="Determined by TranscriberKind in config.json. Change config.json to switch (e.g. between Http and LocalCrispAsrServer)."/>
                </DockPanel>
                <TextBox x:Name="TxtName" Margin="0,0,0,8"/>

                <Label Content="Base URL  (no trailing slash)"/>
                <TextBox x:Name="TxtBaseUrl" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="e.g. https://api.mistral.ai  or  http://localhost:8080"/>

                <Label Content="API Key  (leave blank for local/no-auth endpoints)"/>
                <TextBox x:Name="TxtApiKey" Margin="0,0,0,8"/>

                <Separator Background="#333" Margin="0,4,0,8"/>

                <Label Content="Transcription Endpoint  (full URL — blank = {BaseUrl}/v1/audio/transcriptions)"/>
                <TextBox x:Name="TxtTranscriptionEndpoint" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="e.g. https://api.elevenlabs.io/v1/speech-to-text"/>

                <Label Content="Auth Header Name  (blank = Authorization: Bearer {key})"/>
                <TextBox x:Name="TxtAuthHeaderName" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="e.g. xi-api-key  — sends as: xi-api-key: {your key}"/>

                <Label Content="Model Field Name  (blank = &quot;model&quot;)"/>
                <TextBox x:Name="TxtModelFieldName" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="e.g. model_id for ElevenLabs"/>

                <Separator Background="#333" Margin="0,4,0,8"/>

                <Label Content="Transcription Model  (e.g. voxtral-mini-latest, whisper-1, scribe_v2)"/>
                <TextBox x:Name="TxtTranscriptionModel" Margin="0,0,0,8"/>

                <Separator Background="#333" Margin="0,4,0,8"/>

                <CheckBox x:Name="ChkSupportsTranscription" Content="Supports /v1/audio/transcriptions"/>

                <Separator Background="#333" Margin="0,4,0,8"/>

                <Label Content="Transcription Temperature (0.0-1.0, blank = provider default)"/>
                <TextBox x:Name="TxtTranscriptionTemperature" Margin="0,0,0,4"/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="Lower = more deterministic. Cohere: 0.1, OpenAI: 0.0"/>

                <Label Content="Language (ISO 639-1 code, e.g. en, es, fr)"/>
                <ComboBox x:Name="CmbLanguage" Margin="0,0,0,4">
                    <ComboBoxItem Content="en (English)" Tag="en"/>
                    <ComboBoxItem Content="es (Spanish)" Tag="es"/>
                    <ComboBoxItem Content="fr (French)" Tag="fr"/>
                    <ComboBoxItem Content="de (German)" Tag="de"/>
                    <ComboBoxItem Content="it (Italian)" Tag="it"/>
                    <ComboBoxItem Content="pt (Portuguese)" Tag="pt"/>
                    <ComboBoxItem Content="nl (Dutch)" Tag="nl"/>
                    <ComboBoxItem Content="ja (Japanese)" Tag="ja"/>
                    <ComboBoxItem Content="ko (Korean)" Tag="ko"/>
                    <ComboBoxItem Content="zh (Chinese)" Tag="zh"/>
                    <ComboBoxItem Content="ru (Russian)" Tag="ru"/>
                    <ComboBoxItem Content="ar (Arabic)" Tag="ar"/>
                    <ComboBoxItem Content="hi (Hindi)" Tag="hi"/>
                </ComboBox>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8"
                           Text="Leave blank for auto-detection (where supported)"/>

                <Label Content="Context biasing"/>
                <TextBlock x:Name="BiasInfoLabel" TextWrapping="Wrap"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"
                           Text="Routed automatically."/>
                <TextBlock Foreground="#666" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Vocabulary is entered once in the global Context Bias Terms list (tray → Context Bias Terms) and routed to each provider's native mechanism automatically — no per-provider mode to pick."/>

                <Separator Background="#333" Margin="0,4,0,8"/>

                <GroupBox x:Name="ScribeGroup"
                          Header="ElevenLabs Scribe v2" Margin="0,0,0,4"
                          BorderBrush="#444" Foreground="#AAAAAA">
                    <StackPanel Margin="4,4,4,4">
                        <CheckBox x:Name="ChkTagAudioEvents" Content="Tag audio events ((laughter), (coughing), ...)"
                                  ToolTip="API default is true. Off = clean clinical dictation."/>
                        <CheckBox x:Name="ChkNoVerbatim" Content="Strip fillers and false starts (no_verbatim)"
                                  ToolTip="On = clean output. Off = preserve every &quot;um&quot;/&quot;uh&quot;/restart — better for patient interviews."/>

                        <Label Content="Extra keyterms (optional)" Margin="0,8,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="10" Margin="0,0,0,6">
                            ElevenLabs keyterms come from the global Context Bias Terms list.
                            Add ElevenLabs-only extras here (one per line) — they're merged with
                            that list. Max 1000 terms, &lt;50 chars each, 5 words max. ~20% cost surcharge.
                        </TextBlock>
                        <TextBox x:Name="TxtScribeKeyterms"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 MaxHeight="280"
                                 FontFamily="Consolas"
                                 TextChanged="TxtScribeKeyterms_TextChanged"/>
                        <TextBlock x:Name="KeytermsCountLabel" Margin="0,4,0,0" Foreground="#666" FontSize="10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="LocalCrispGroup"
                          Header="Advanced — Local CrispASR server" Margin="0,0,0,4"
                          BorderBrush="#444" Foreground="#AAAAAA">
                    <StackPanel Margin="4,4,4,4">
                        <Label Content="Beam size (beam_size)"/>
                        <TextBox x:Name="TxtLocalBeamSize" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="10" Margin="0,0,0,8"
                                   Text="Blank = server default (greedy). 5 is a good starting point — better accuracy, slower decode. Requires CrispASR v0.7+."/>
                        <Label Content="Hotword boost (Parakeet only)"/>
                        <TextBox x:Name="TxtHotwordsBoost" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="10"
                                   Text="Strength of the Parakeet hotword trie. Blank = off (server default 2.0 ≈ no effect). ~10+ nudges rare terms but can GARBLE neighboring words — leave blank unless you accept that trade-off. Greedy (beam 1) weakens it; pair with beam ≥2. Ignored by Cohere/Voxtral/Granite backends."/>
                    </StackPanel>
                </GroupBox>

                <Separator Background="#333" Margin="0,8,0,8"/>

                <GroupBox Header="Advanced — Local GPU Backend" Margin="0,0,0,4"
                          BorderBrush="#444" Foreground="#AAAAAA">
                    <StackPanel Margin="4,4,4,4">
                        <Label Content="Backend for Cohere Local Q4 / Q6_K providers"/>
                        <ComboBox x:Name="CmbGpuBackend" Margin="0,0,0,4"
                                  ToolTip="Controls how Cohere Local Q4 and Q6_K providers run. Auto lets crispasr choose; Vulkan uses the integrated GPU; CPU disables GPU entirely. Changes take effect on the next dictation — any running server is restarted.">
                            <ComboBoxItem Content="Auto (recommended)" Tag="auto"/>
                            <ComboBoxItem Content="Vulkan (GPU)" Tag="vulkan"/>
                            <ComboBoxItem Content="CUDA (NVIDIA GPU)" Tag="cuda"/>
                            <ComboBoxItem Content="CPU only" Tag="cpu"/>
                            <ComboBoxItem x:Name="GpuBackendMetalItem" Content="Metal (macOS)" Tag="metal" IsEnabled="False"/>
                        </ComboBox>
                        <TextBlock x:Name="GpuBackendStatusLabel"
                                   Margin="0,2,0,0" Foreground="#888" FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="Detecting GPU…"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click"
                    Background="#2A4A2A" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
